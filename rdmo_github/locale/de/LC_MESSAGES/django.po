#: forms/forms.py:42
msgid "Create new repository"
msgstr "Neues Repositorium anlegen"

#: forms/forms.py:51
msgid "Name for the new repository"
msgstr "Name des neuen Repositoriums"

#: forms/forms.py:53
msgid ""
"Unique name for the new repository. No other of your repositories may have "
"the same name, otherwise the export will fail."
msgstr ""
"Eindeutiger Name für das neue Repositorium. Kein anderes Ihrer Repositorien "
"darf denselben Namen haben, da sonst der Export fehlschlägt."

#: forms/forms.py:56
msgid "example-repo-name"
msgstr "beispiel-repo-name"

#: forms/forms.py:61 forms/forms.py:132 forms/forms.py:138
msgid "GitHub repository"
msgstr "GitHub-Repositorium"

#: forms/forms.py:67
msgid "Export choices"
msgstr "Optionen zum Exportieren"

#: forms/forms.py:68
msgid "Warning: Existing content in GitHub will be overwritten."
msgstr "Warnung: Bestehende Inhalte in GitHub werden überschrieben."

#: forms/forms.py:73
msgid "Branch"
msgstr "Branch"

#: forms/forms.py:74
msgid ""
"An existing branch in the GitHub repository. For a new repository it must be "
"the default branch \"main\"."
msgstr ""
"Ein bestehender Branch im GitHub-Repositorium. Bei einem neuen Repositorium "
"muss er der Standardbranch „main“ sein."

#: forms/forms.py:78
msgid "Commit message"
msgstr "Commitnachricht"

#: forms/forms.py:93
msgid "A name for the new repository is required."
msgstr "Ein Name für das neue Repositorium ist erforderlich."

#: forms/forms.py:99 forms/forms.py:170 forms/forms.py:173
msgid "A GitHub repository is required."
msgstr "Ein GitHub-Repositorium ist erforderlich."

#: forms/forms.py:117 providers/exports.py:34 providers/exports.py:35
#: providers/exports.py:36 providers/exports.py:37
msgid "File path"
msgstr "Dateipfad"

#: forms/forms.py:118
msgid ""
"The import file's relative path in the repository. The file must be in XML "
"format."
msgstr ""
"Der relative Pfad der Importdatei im Repositorium. Die Datei muss im XML-"
"Format vorliegen."

#: forms/forms.py:119 providers/exports.py:56
msgid "example_folder/example_xml_file.xml"
msgstr "beispiel_ordner/beispiel_xml_datei.xml"

#: forms/forms.py:124
msgid "Use other repository"
msgstr "Ein anderes Repositorium benutzen"

#: forms/forms.py:140
msgid ""
"URL of GitHub repository you want to import from. If this repository is not "
"public, you must have access to it."
msgstr ""
"URL des GitHub-Repositoriums, aus dem Sie importieren möchten. Wenn dieses "
"Repositorium nicht öffentlich ist, muss es für Sie zugänglich sein."

#: forms/forms.py:142
msgid "https://github.com/example-owner/example-repo"
msgstr "https://github.com/beispiel-besitzerin/beispiel-repo"

#: forms/forms.py:147
msgid "Import choices"
msgstr "Optionen zum Importieren"

#: forms/forms.py:148
msgid ""
"Select the choices you want to import from. Once they are in the gray box, "
"move them to prioritize them."
msgstr ""
"Wählen Sie die Optionen aus, die Sie importieren möchten. Sobald sie sich im "
"grauen Bereich befinden, verschieben Sie sie, um sie zu priorisieren."

#: forms/forms.py:153
msgid "Branch, tag, or commit"
msgstr "Branch, Tag, oder Commit"

#: forms/validators.py:7
msgid "Repository name"
msgstr "Name des Repositoriums"

#: forms/validators.py:11
msgid "alphanumeric, hyphen, underscore, and period"
msgstr "alphanumerisch, Bindestrich, Unterstrich und Punkt"

#: forms/validators.py:18
msgid "File must be in XML format."
msgstr "Die Datei muss im XML-Format vorliegen."

#: mixins.py:210
msgid "Request (export or import) error"
msgstr "Anfragefehler (Export oder Import)"

#: mixins.py:211
#, python-format
msgid "Something went wrong: %s"
msgstr "Etwas ist schief gelaufen: %s"

#: mixins.py:235 mixins.py:281
msgid "GitHub callback error"
msgstr "GitHub-Callback-Fehler"

#: mixins.py:236
msgid "State parameter did not match."
msgstr "Der Parameter 'state' stimmt nicht überein."

#: mixins.py:282
msgid "No redirect could be found."
msgstr "Kein redirect gefunden."

#: mixins.py:423
msgid "Authorize App"
msgstr "App autorisieren"

#: mixins.py:424
msgid ""
"To connect to GitHub repositories, you first need to authorize the MPDL app."
msgstr ""
"Die Verbindung zu GitHub-Repositorien erfordert die Autorisierung der MPDL-"
"App."

#: mixins.py:432
msgid "Install App"
msgstr "App installieren"

#: mixins.py:433
msgid ""
"To connect to GitHub repositories, you first need to install the MPDL app."
msgstr ""
"Die Verbindung zu GitHub-Repositorien erfordert die Installation der MPDL-"
"App."

#: mixins.py:438
msgid "Update list"
msgstr "Liste aktualisieren"

#: mixins.py:439
msgid ""
"List of your accessible GitHub repositories (up to 10 will be shown here)."
msgstr ""
"Liste der für Sie zugänglichen GitHub-Repositorien (bis zu 10 werden hier "
"angezeigt)."

#: mixins.py:448
msgid "You do not have any GitHub repositories yet"
msgstr "Sie haben noch keine GitHub-Repositorien"

#: mixins.py:451
msgid "To add more repositories to this list, click"
msgstr "Um die Repositorien-Liste zu erweitern, klicken Sie"

#: mixins.py:452
msgid "here"
msgstr "hier"

#: mixins.py:458
msgid "These are your most recently updated, accessible GitHub repositories."
msgstr ""
"Das sind Ihre zuletzt aktualisierten, zugänglichen Github-Repositorien."

#: providers/exports.py:35
msgid "CSV (comma separated)"
msgstr "CSV (Komma getrennt)"

#: providers/exports.py:36
msgid "CSV (semicolon separated)"
msgstr "CSV (Semikolon getrennt)"

#: providers/exports.py:61 providers/exports.py:66
msgid "example_folder/example_csv_file.csv"
msgstr "beispiel_ordner/beispiel_csv_datei.csv"

#: providers/exports.py:71
msgid "example_folder/example_json_file.json"
msgstr "beispiel_ordner/beispiel_json_datei.json"

#: providers/exports.py:143
msgid "Something went wrong"
msgstr "Etwas ist schief gelaufen"

#: providers/exports.py:144
msgid ""
"Either export choices could not be created or repository content would have "
"been overwritten without a warning."
msgstr ""
"Entweder konnten die Export-Optionen nicht erstellt werden oder der Inhalt "
"des Repositoriums wäre ohne Warnung überschrieben worden."

#: providers/exports.py:192
msgid ""
"A file with the same path exists in the selected repository and will be "
"overwritten"
msgstr ""
"Eine Datei mit demselben Pfad existiert im ausgewählten Repositorium und "
"wird überschrieben"

#: providers/exports.py:286
msgid ""
"not exported - it would have overwritten existing file in repository without "
"a warning."
msgstr ""
"nicht exportiert - es hätte die bestehende Datei im Repositorium ohne "
"Warnung überschrieben."

#: providers/exports.py:299
msgid "not exported - it could not be created."
msgstr "nicht exportiert - es konnte nicht erstellt werden."

#: providers/exports.py:302
msgid "successfully exported."
msgstr "erfolgreich exportiert."

#: providers/exports.py:354 providers/exports.py:358
msgid "not exported - something went wrong."
msgstr "nicht exportiert - etwas ist schief gelaufen."

#: providers/exports.py:407
msgid "Add GitHub integration"
msgstr "GitHub-Integration hinzufügen"

#: providers/exports.py:408
msgid "Send to GitHub"
msgstr "An GitHub senden"

#: providers/exports.py:409
msgid ""
"This integration allows the creation of issues in arbitrary GitHub "
"repositories. The upload of attachments is not supported by GitHub."
msgstr ""
"Diese Integration ermöglicht die Erstellung von Issues in beliebigen GitHub-"
"Repositorien. Das Hochladen von Anhängen wird von GitHub nicht unterstützt."

#: providers/exports.py:416
msgid "The URL of the GitHub repository to send issues to."
msgstr ""
"Die URL des GitHub-Repositoriums, an das Issues gesendet werden sollen."

#: providers/exports.py:421
msgid "The secret for a GitHub webhook to close a task (optional)."
msgstr ""
"Das 'secret' für einen GitHub-Webhook zum Schließen einer Aufgabe (optional)."

#: providers/imports.py:104
msgid "GitHub Import"
msgstr "GitHub-Import"

#: providers/imports.py:118 providers/imports.py:168
msgid "Import error"
msgstr "Fehler beim Import"

#: providers/imports.py:119
msgid "Something went wrong."
msgstr "Etwas ist schief gelaufen."

#: providers/imports.py:169
msgid "Either none of the import choices exist or they could not be requested."
msgstr ""
"Entweder existieren die Importoptionen nicht oder sie konnten nicht "
"angefragt werden."

#: providers/imports.py:226
msgid ""
"Either there is no file with this path in the selected repository or it "
"cannot be requested"
msgstr ""
"Entweder existiert keine Datei mit diesem Pfad im ausgewälten Repositorium "
"oder sie kann nicht angefragt werden"

#: providers/imports.py:228
msgid "Repository endpoint cannot be requested"
msgstr "Der Repositorium-Endpunkt kann nicht angefragt werden"

#: providers/imports.py:334
msgid " and"
msgstr " und"

#: templates/plugins/github_export_form.html:10
#: templates/plugins/github_export_form.html:12
msgid "Export to GitHub"
msgstr "Nach GitHub exportieren"

#: templates/plugins/github_export_success.html:6
msgid "Successful Export to GitHub"
msgstr "Erfolgreicher Export nach GitHub"

#: templates/plugins/github_export_success.html:14
msgid "Go to GitHub repository"
msgstr "Zum GitHub-Repositorium"

#: templates/plugins/github_import_success.html:12
msgid "Successful Import from GitHub"
msgstr "Erfolgreicher Import aus GitHub"

#: templates/plugins/github_import_success.html:15
msgid "This import choice could not be requested"
msgstr "Diese Importoption konnte nicht angefragt werden"

#: templates/plugins/github_import_success.html:17
msgid "These import choices could not be requested"
msgstr "Diese Importoptionen konnten nicht angefragt werden"

#: templates/plugins/github_import_success.html:25
msgid ""
"You could either import the rest of the values found in the repository or "
"cancel the process."
msgstr ""
"Sie können den Rest der im Repositorium gefundenen Werte importieren oder "
"den Prozess abbrechen."

#: templates/plugins/github_import_success.html:28
msgid "Import anyway"
msgstr "Trotzdem importieren"

#: templates/plugins/github_import_success.html:29
msgid "Cancel"
msgstr "Abbrechen"
